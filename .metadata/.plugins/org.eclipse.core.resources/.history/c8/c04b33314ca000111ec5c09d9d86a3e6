package core_practice;

public class operators {

	public static void main(String[] args) {
		int num = 10;
		System.out.println(num%3);
		System.out.println(num/2);
		System.out.println(num*3);
		System.out.println(num+3);
		System.out.println(num-3);
		num+= 5;
		System.out.println(num);
		num-=5;
		System.out.println(num);

	}

}
